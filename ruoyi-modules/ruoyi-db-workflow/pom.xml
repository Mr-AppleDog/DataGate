<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.dromara</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-db-workflow</artifactId>

    <description>
        ruoyi-db-workflow 权限/导出/变更工单领域流程，适配 WarmFlow（docs/02 第 6.4 节）。
    </description>

    <dependencies>
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-db-core</artifactId>
        </dependency>

        <!-- 授权写侧（审批通过生成 Grant） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-db-auth</artifactId>
        </dependency>

        <!-- M5 导出/变更工单：数据源/连接器注册表/路径解析/加密对象存储/列策略解析 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-db-resource</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <!-- Sa-Token：LoginHelper 取当前申请人/审批人（审批人不能自批，docs/03 §13 #9） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-satoken</artifactId>
        </dependency>

        <!-- 通用工作流服务（起流程/办理，org.dromara.common.core.service.WorkflowService） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <!-- WarmFlow 审批推进（terminationTask 保留拒绝/撤销轨迹，M2 收尾） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-workflow</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
