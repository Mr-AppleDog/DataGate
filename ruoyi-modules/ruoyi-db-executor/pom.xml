<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.dromara</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-db-executor</artifactId>

    <description>
        ruoyi-db-executor 查询/Redis/导出/变更执行网关（docs/02 第 6.6 节）。
        独立连接池，禁止注册进 dynamic-datasource；禁止直接接收“数据源ID+任意SQL”。
    </description>

    <dependencies>
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-db-core</artifactId>
        </dependency>

        <!-- 执行网关编排所需：数据源/凭据/连接器注册表 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-db-resource</artifactId>
        </dependency>

        <!-- 授权判定 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-db-auth</artifactId>
        </dependency>

        <!-- 查询审计写入 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-db-audit</artifactId>
        </dependency>

        <!-- M6-02 监控指标埋点：Micrometer 计时器/计数器（actuator/prometheus 由 ruoyi-admin 运行时提供） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- 操作人上下文（审计 actor 快照） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-satoken</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- M5 #8 导出真实 DB 集成：真实 MySQL 连接器（test scope，不污染运行时） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-db-connector-mysql</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
